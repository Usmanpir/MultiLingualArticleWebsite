# ─────────────────────────────────────────────────────────────
# FutureSphere — environment variables
# Copy to .env (local) and set the same keys in Vercel → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────
# Pooled connection used by the app at runtime (e.g. Neon/Supabase pooler URL on Vercel).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futuresphere?schema=public"
# Optional: direct (non-pooled) URL used by `prisma migrate`. Falls back to DATABASE_URL.
DIRECT_URL=""
# Optional: max connections per server instance (default 5).
DATABASE_POOL_MAX=""

# ── Auth ─────────────────────────────────────────────────────
# Random string, 32+ characters. Generate: openssl rand -base64 48
# (NEXTAUTH_SECRET is also accepted for compatibility.)
AUTH_SECRET=""

# Initial admin account created by `npm run db:seed` (only if it doesn't exist yet).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ── Site ─────────────────────────────────────────────────────
# Public origin without trailing slash. Used for canonical URLs, hreflang, sitemaps, OG.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="FutureSphere"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_EDITORIAL_EMAIL="editors@example.com"
# "true" on staging/preview: noindex every page and disallow all in robots.txt.
NEXT_PUBLIC_NOINDEX="false"

# ── Search engine verification (optional; can also be set in Admin → Settings) ──
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ── Google Analytics 4 (optional) ────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Google AdSense (optional) ────────────────────────────────
# Publisher id, e.g. ca-pub-0000000000000000. Ad unit slot ids are managed in Admin → Advertising.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# Master switch. Ads render only when this is "true" AND a client id AND an active ad unit exist.
NEXT_PUBLIC_ADSENSE_ENABLED="false"
# "true" adds data-adtest="on" and allows ads to render in development.
NEXT_PUBLIC_ADSENSE_TEST="false"

# ── Privacy / consent ────────────────────────────────────────
# Where opt-in consent is required before analytics/ads load:
#   "*"            everywhere (default, safest)
#   "none"         nowhere
#   "DE,FR,GB,..." ISO country codes (uses Vercel's x-vercel-ip-country header)
NEXT_PUBLIC_CONSENT_REGIONS="*"

# ── Media storage ────────────────────────────────────────────
# Vercel Blob read/write token (required for uploads on Vercel; local dev writes to public/uploads).
BLOB_READ_WRITE_TOKEN=""
# Extra image hosts allowed for next/image, comma separated (e.g. a CDN).
MEDIA_REMOTE_HOSTS=""

# ── Cron ─────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/publish-scheduled.
CRON_SECRET=""

# ── Debug ────────────────────────────────────────────────────
PRISMA_LOG_QUERIES="false"
