// FutureSphere — PostgreSQL schema (Prisma ORM 7)
// Connection URL lives in prisma.config.ts; the runtime uses @prisma/adapter-pg.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum RoleName {
  ADMIN
  EDITOR
  AUTHOR
}

enum TextDirection {
  LTR
  RTL
}

enum ArticleStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum TranslationStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum RobotsDirective {
  INDEX_FOLLOW
  NOINDEX_FOLLOW
  NOINDEX_NOFOLLOW
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum MediaStorage {
  LOCAL
  BLOB
  EXTERNAL
}

enum AdPlacement {
  HEADER_BANNER
  HOME_INLINE
  ARTICLE_TOP
  ARTICLE_MIDDLE
  ARTICLE_BOTTOM
  SIDEBAR
  MOBILE_STICKY
}

// ─────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  roleId         String
  isActive       Boolean   @default(true)
  /// Incremented to invalidate every existing session (logout everywhere / password change).
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role     Role          @relation(fields: [roleId], references: [id])
  author   Author?
  media    Media[]
  activity ActivityLog[]

  @@index([roleId])
}

model Author {
  id        String   @id @default(cuid())
  userId    String?  @unique
  slug      String   @unique
  name      String
  avatarUrl String?
  website   String?
  twitter   String?
  linkedin  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  translations AuthorTranslation[]
  articles     Article[]
}

model AuthorTranslation {
  id         String  @id @default(cuid())
  authorId   String
  languageId String
  jobTitle   String?
  bio        String? @db.Text

  author   Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([authorId, languageId])
}

// ─────────────────────────────────────────────────────────────
// Localisation
// ─────────────────────────────────────────────────────────────

model Language {
  id         String        @id @default(cuid())
  code       String        @unique // BCP-47 primary tag used in URLs: en, ur, ar
  name       String // English name
  nativeName String
  locale     String // Open Graph locale, e.g. en_US
  direction  TextDirection @default(LTR)
  isActive   Boolean       @default(true)
  isDefault  Boolean       @default(false)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  articleTranslations    ArticleTranslation[]
  categoryTranslations   CategoryTranslation[]
  tagTranslations        TagTranslation[]
  authorTranslations     AuthorTranslation[]
  staticPageTranslations StaticPageTranslation[]
}

// ─────────────────────────────────────────────────────────────
// Taxonomy
// ─────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// Accent colour used in the UI (hex).
  color     String   @default("#22d3ee")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  articles     Article[]

  @@index([isActive, sortOrder])
}

model CategoryTranslation {
  id             String  @id @default(cuid())
  categoryId     String
  languageId     String
  name           String
  description    String? @db.Text
  seoTitle       String?
  seoDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@index([languageId])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations TagTranslation[]
  articles     ArticleTag[]
}

model TagTranslation {
  id          String  @id @default(cuid())
  tagId       String
  languageId  String
  name        String
  description String? @db.Text

  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageId])
  @@index([languageId, name])
}

// ─────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────

model Article {
  id              String        @id @default(cuid())
  authorId        String
  categoryId      String
  featuredImageId String?
  status          ArticleStatus @default(DRAFT)
  featured        Boolean       @default(false)
  trending        Boolean       @default(false)
  editorsPick     Boolean       @default(false)
  allowComments   Boolean       @default(true)
  /// Aggregated unique daily views (see ArticleView).
  views           Int           @default(0)
  /// Primary keyword/topic for editorial SEO planning (not rendered as meta keywords).
  primaryTopic    String?
  secondaryTopics String[]      @default([])
  /// For SCHEDULED articles this is the go-live time.
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author        Author               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  featuredImage Media?               @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  translations  ArticleTranslation[]
  tags          ArticleTag[]
  comments      Comment[]
  viewLog       ArticleView[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId, status, publishedAt(sort: Desc)])
  @@index([featured, status, publishedAt(sort: Desc)])
  @@index([trending, status, publishedAt(sort: Desc)])
  @@index([views(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ArticleTranslation {
  id                 String            @id @default(cuid())
  articleId          String
  languageId         String
  status             TranslationStatus @default(DRAFT)
  title              String
  slug               String
  excerpt            String            @db.Text
  /// Sanitised HTML (sanitised again on render).
  content            String            @db.Text
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  robots             RobotsDirective   @default(INDEX_FOLLOW)
  wordCount          Int               @default(0)
  readingTimeMinutes Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([articleId, languageId])
  @@unique([languageId, slug])
  @@index([languageId, status])
  @@index([slug])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Media {
  id           String       @id @default(cuid())
  url          String
  /// Storage key (blob pathname or local file path) used for deletion.
  storageKey   String?
  storage      MediaStorage @default(EXTERNAL)
  filename     String
  mimeType     String
  size         Int          @default(0)
  width        Int
  height       Int
  alt          String
  caption      String?
  credit       String?
  uploadedById String?
  createdAt    DateTime     @default(now())

  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  articles   Article[]

  @@index([createdAt(sort: Desc)])
}

model StaticPage {
  id        String   @id @default(cuid())
  /// Route key: about, contact, privacy, terms, cookie-policy, editorial-policy, advertising-policy
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations StaticPageTranslation[]
}

model StaticPageTranslation {
  id             String   @id @default(cuid())
  pageId         String
  languageId     String
  title          String
  seoDescription String
  content        String   @db.Text
  updatedAt      DateTime @updatedAt

  page     StaticPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([pageId, languageId])
}

// ─────────────────────────────────────────────────────────────
// Engagement
// ─────────────────────────────────────────────────────────────

model Comment {
  id           String        @id @default(cuid())
  articleId    String
  languageCode String
  authorName   String
  /// Never rendered publicly.
  authorEmail  String?
  content      String        @db.Text
  status       CommentStatus @default(PENDING)
  /// Salted hash — raw IPs are never stored.
  ipHash       String?
  createdAt    DateTime      @default(now())
  moderatedAt  DateTime?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, status, createdAt])
  @@index([status, createdAt(sort: Desc)])
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  languageCode     String           @default("en")
  status           SubscriberStatus @default(SUBSCRIBED)
  unsubscribeToken String           @unique
  source           String?
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

/// One row per (article, anonymous visitor, day). Visitor hash rotates daily
/// and is derived without cookies, so no personal data is stored.
model ArticleView {
  id           String   @id @default(cuid())
  articleId    String
  languageCode String
  visitorHash  String
  viewDate     DateTime @db.Date
  createdAt    DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, visitorHash, viewDate])
  @@index([viewDate])
  @@index([articleId, viewDate])
}

// ─────────────────────────────────────────────────────────────
// Monetisation, settings, operations
// ─────────────────────────────────────────────────────────────

model Advertisement {
  id         String      @id @default(cuid())
  name       String
  placement  AdPlacement
  /// AdSense ad unit slot id (data-ad-slot). The publisher client id comes from env.
  adSlotId   String
  format     String      @default("auto")
  responsive Boolean     @default(true)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([placement, isActive])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Redirect {
  id          String   @id @default(cuid())
  /// Path only, e.g. /en/ai/old-slug
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
